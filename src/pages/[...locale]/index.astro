---
// src/pages/[...locale]/index.astro
import "@/styles/global.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import NavPhotoSection from "@/components/NavPhotoSection.astro";
import { defaultLang, locales } from "@/../i18n.config";
import { getI18nInfo } from "@/utils/i18n";

// Genera rutas estáticas: "/", "/en"
export function getStaticPaths() {
  return locales.map((lang) => {
    if (lang === defaultLang) {
      return { params: { locale: undefined } };
    }
    return { params: { locale: lang } };
  });
}
const { dictionary, langParam } = await getI18nInfo(Astro.params.locale);
const { indexPage } = dictionary; // Contenido específico de la página principal
---

<BaseLayout
  title={indexPage.title}
  lang={langParam}
  description={indexPage.description}
  isLanding={true}
>
  <h1 class="sr-only">{indexPage.title} - {indexPage.description}</h1>
  <p class="sr-only">
    Bienvenido al portafolio de Jowy. {indexPage.description}
  </p>
  <div
    id="landing-sections"
    class="flex min-h-screen w-full flex-col overflow-hidden md:flex-row"
  >
    {indexPage.sections.map((section, index) => (
      <NavPhotoSection
        {...section}
        loading={index === 0 ? "eager" : "lazy"}
        fetchpriority={index === 0 ? "high" : "auto"}
      />
    ))}
  </div>

  <script>
    document.addEventListener("astro:page-load", () => {
      const container = document.getElementById("landing-sections");
      const main = document.getElementById("main-wrapper");
      if (!container) return;

      const handleReveal = () => {
        container.classList.add("visible");
      };

      // Si el contenido ya es visible (ej: navegación rápida o recarga sin intro), mostrar inmediatamente
      if (main && !main.classList.contains("opacity-0")) {
        handleReveal();
      } else {
        // Si no, esperar al evento del layout
        window.addEventListener("intro-reveal", handleReveal, { once: true });
      }
    });
  </script>

  <style>
    /* Hide only subsequent sections initially to avoid blocking LCP on the Hero */
    #landing-sections > :global(*:not(:first-child)) {
      opacity: 0;
      transform: translateY(50px);
      transition:
        opacity 1s ease-out,
        transform 1s ease-out;
    }

    #landing-sections.visible > :global(*:not(:first-child)) {
      opacity: 1;
      transform: translateY(0);
    }

    #landing-sections.visible > :global(*:nth-child(2)) {
      transition-delay: 300ms;
    }
    #landing-sections.visible > :global(*:nth-child(3)) {
      transition-delay: 500ms;
    }
  </style>
</BaseLayout>
