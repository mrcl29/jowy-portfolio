---
import PrivacyEmbed from "./PrivacyEmbed.astro";

interface YouTubePlayerProps {
  videoId: string;
  title: string;
  loading?: "lazy" | "eager";
}

const { videoId, title } = Astro.props as YouTubePlayerProps;

const url = `https://www.youtube.com/embed/${videoId}`;
const poster = `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`;
---

<PrivacyEmbed
  url={url}
  title={title}
  poster={poster}
  class="aspect-video h-auto min-h-100 w-full rounded-lg"
/>
