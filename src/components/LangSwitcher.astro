---
// src/components/LangSwitcher.astro
import { getRelativeLocaleUrl } from "astro:i18n";

const currentPath = Astro.url.pathname;

// quitamos el prefijo de idioma si existe
const normalizedPath = currentPath.replace(/^\/(en|es)(\/|$)/, "/");

const otherLang = Astro.currentLocale === "es" ? "en" : "es";
const otherUrl = getRelativeLocaleUrl(otherLang, normalizedPath);
---

<a
  href={otherUrl}
  class="z-9999 flex cursor-pointer items-center justify-center sm:text-sm md:text-base lg:text-lg"
>
  <span
    class="neon-style font-bold transition-all duration-300 hover:scale-125"
  >
    {otherLang.toUpperCase()}
  </span>
</a>
