---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import { getI18nInfo } from "@/utils/i18n";
import { homeDarkIcon } from "@/constants/icons";
import { type SocialNetworksList } from "@/types/socialNetworksList";
import SocialNetworksListComponent from "@/components/SocialNetworksList.astro";
import { djEmail, designerEmail } from "@/constants/email";
import { creatorNetworkList } from "@/constants/socialNetworksList";
import VerticalMarquee from '@/components/VerticalMarquee.astro';
import LangSwitcher from "@/components/LangSwitcher.astro";
import { defaultLang } from "i18n.config";

interface PageLayoutProps {
  title: string;
  phrase?: string;
  socialNetworksList?: SocialNetworksList;
  neonGlowColor?: string;
  lang?: string;
}

const { title, phrase, socialNetworksList, neonGlowColor, lang=defaultLang } = Astro.props as PageLayoutProps;

const { dictionary, langParam } = await getI18nInfo(Astro.params.locale);
const { indexPage, bioPage } = dictionary;

const homeUrl = getRelativeLocaleUrl(langParam, "/");

const mainStyle = neonGlowColor ? `--neon-glow-color: ${neonGlowColor};` : "";
---

<a href={homeUrl}>
  <Image
    id="nav-home-icon"
    src={homeDarkIcon}
    alt="Home Icon"
    class="fixed top-4 left-5 z-9999 h-[3vw] max-h-10 min-h-5 w-auto transition duration-300 ease-in-out hover:scale-120 neon-icon-no-invert"
    loading="eager"
    fetchpriority="high"
    format="png"
  />
</a>

<div
            id="nav-icons"
            class={`fixed top-5 right-5 z-9999 flex flex-row justify-center gap-8 pt-[1dvh] align-middle`}
        >
            <LangSwitcher currentLang={lang} />
        </div>

<main class="mx-auto lg:max-w-5xl px-3 lg:px-20 py-12" style={mainStyle}>
    {
        phrase && (
          <VerticalMarquee text={phrase} side="left" neonGlowColor={neonGlowColor} />
          <VerticalMarquee text={phrase} side="right" neonGlowColor={neonGlowColor} />
        )
      }
  <h1
    class="neon-text-glow mb-15 flex w-full justify-center align-middle lg:text-6xl md:text-5xl text-3xl font-extrabold"
  >
    {title}
  </h1>
  <div
    class="flex min-h-screen w-full flex-col items-center gap-8 overflow-hidden mb-10"
  >
    <slot />
  </div>

  {
  socialNetworksList && (
    <div class="lg:fixed lg:top-1/2 lg:left-4 flex z-50 lg:-translate-y-1/2 items-center justify-center">
      <SocialNetworksListComponent socialNetworksList={socialNetworksList} orientation="responsive" email={djEmail} />
    </div>
  )
}
</main>

<footer
  class="relative z-10 pb-15 mt-10 lg:mt-20 w-full border-t border-gray-700 px-6 py-8 text-center text-sm text-gray-400 bg-black"
>
  <div
    class="w-full flex flex-col items-center justify-between gap-8 md:flex-row px-25"
  >
    <!-- Quick Links -->
    <nav class="flex flex-wrap justify-center gap-x-6 gap-y-2">
      <a href={homeUrl} class="hover:text-white">{indexPage.title}</a>
      {
        indexPage.sections.map(
          (section) =>
            section.link && (
              <a
                href={getRelativeLocaleUrl(langParam, `/${section.link}`)}
                class="hover:text-white"
              >
                {section.title}
              </a>
            )
        )
      }
        <a
                href={getRelativeLocaleUrl(langParam, `/${bioPage.link}`)}
                class="hover:text-white"
              >
                {bioPage.title}
              </a>
    </nav>

    <!-- Social Networks -->
    <div
      class="flex flex-row items-center justify-end gap-4 text-center align-middle"
    >
      {dictionary.common.creator}
      {
        socialNetworksList && (
          <SocialNetworksListComponent
            socialNetworksList={creatorNetworkList}
            orientation="vertical"
            loadingMode="lazy"
            email={designerEmail}
          />
        )
      }
    </div>
  </div>

  <!-- Copyright and Legal -->
  <div class="mt-8">
    <p>
      &copy; {new Date().getFullYear()}
      {dictionary.common.footer.copyright}
    </p>
    <div class="mt-2 flex flex-wrap justify-center gap-x-4">
      <a href={`mailto:${{ djEmail }}`} class="hover:text-white">
        {djEmail}
      </a>
      <!-- <span class="text-gray-500">|</span>
      <a href="#" class="hover:text-white">
        {dictionary.common.footer.privacyPolicy}
      </a> -->
    </div>
  </div>
</footer>

<style is:global>
  .neon-text-glow {
    color: var(--neon-glow-color);
    text-shadow:
      0 0 5px var(--neon-glow-color, transparent),
      0 0 10px var(--neon-glow-color, transparent),
      0 0 20px var(--neon-glow-color, transparent);
  }

  .neon-text {
    color: var(--neon-glow-color);
  }

   .neon-icon {
    filter: invert(1) drop-shadow(0 0 6px var(--neon-glow-color, #ffffff))
      drop-shadow(0 0 8px var(--neon-glow-color, #ffffff));
  }

  .neon-icon-no-invert {
    filter: drop-shadow(0 0 6px var(--neon-glow-color, #ffffff))
      drop-shadow(0 0 8px var(--neon-glow-color, #ffffff));
  }
</style>
